        "parameters": {
          "jsCode": "const items = $input.all();\nif (items.length === 0 || !items[0].json || !items[0].json.response) {\n  return [{ json: { error: 'No response from AI' } }];\n}\n\n// Strip markdown code fences (```json ... ``` or ``` ... ```)\nlet raw = items[0].json.response.trim();\nraw = raw.replace(/^```(?:json)?\\s*/i, '').replace(/\\s*```$/, '').trim();\n\nlet parsed = {};\ntry {\n  parsed = JSON.parse(raw);\n} catch(e) {\n  // Fallback: regex extract individual fields\n  function extract(key, text) {\n    const m = text.match(new RegExp('\"' + key + '\"\\\\s*:\\\\s*\"([\\\\s\\\\S]*?)(?=\"\\\\s*[,}])', ''));\n    return m ? m[1].replace(/\\\\n/g, '\\n').replace(/\\\\\"/g, '\"').trim() : '';\n  }\n  parsed = {\n    script: extract('script', raw),\n    title: extract('title', raw),\n    description: extract('description', raw),\n    on_screen_title: extract('on_screen_title', raw)\n  };\n}\n\nlet script = parsed.script || '';\nif (typeof script === 'string' && script.trim().startsWith('[')) {\n  try {\n    script = JSON.parse(script);\n  } catch(e) {}\n}\n\nreturn [{\n  json: {\n    script: script || 'Script failed',\n    title: parsed.title || 'New Video',\n    description: parsed.description || '#shorts',\n    on_screen_title: (parsed.on_screen_title || 'TOP REVEAL').toUpperCase(),\n    row_number: $('Filter Next Row1').item.json.row_number\n  }\n}];"
