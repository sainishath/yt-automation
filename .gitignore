# =============================================================================
# YouTube Automations — Production Git Ignore Rules
# =============================================================================

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# Binary executables, DLLs & large models
*.exe
*.dll
*.so
*.dylib
*.onnx
*.ort
*.bin
*.pt
*.safetensors
*.sqlite
*.sqlite3
*.db
growth/growth.db
growth/*.db
*.db-journal
*.db-shm
*.db-wal
growth/*.db-journal
growth/*.db-shm
growth/*.db-wal

# Secrets, API Keys & OAuth Credentials (CRITICAL)
.env
*.env
.env.*
!.env.example
*token*.json
*token*.pickle
*secret*.json
*credentials*.json
*.pem
*.key
assets/*.txt
assets/client_secret*
assets/GOCSPX*
assets/*key*
assets/*secret*

# Pipeline 2 & Secondary Modules (Preserved on dedicated branch backup/pipeline-2)
convo-shorts/
repograder/

# Runtime Output & Media Assets
output/
**/output/
temp/
**/temp/
data/yt-automation-engine/videos/
data/yt-automation-engine/temp/
videos/
**/videos/
*.mp4
*.wav
*.mp3
*.webm
*.avi
*.mov
*.png
*.jpg
*.jpeg
espeak-ng-data/

# Showcase & Visual Grounding Assets (Allowed for Private Repo Context)
!assets/sample_scenes/**/*.png
!assets/sample_scenes/**/*.jpg
!assets/sample_scenes/**/*.jpeg

# Local Unprocessed / Secondary Reference Assets
assets/*.docx
assets/*.csv
assets/*.html
assets/*.json

# Logs & Runtime State
*.log
pipeline.log
*.tmp
tasks_db.json
quota_tracker.json

# Scratch, Test Runs & Agent Files
scratch/
.agents/
.gemini/
.idea/
.vscode/
*.swp
*~
Thumbs.db
Desktop.ini
