# =============================================================================
# YouTube Automations — Production Git Ignore Rules
# =============================================================================

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# Binary executables, DLLs & large models
*.exe
*.dll
*.so
*.dylib
*.onnx
*.ort
*.bin
*.pt
*.safetensors
*.sqlite
*.sqlite3
*.db

# Secrets, API Keys & OAuth Credentials (CRITICAL)
*.env
.env.*
!.env.example
*token*.json
*token*.pickle
*secret*.json
*credentials*.json
*.pem
*.key

# Runtime Output & Media Assets
output/
data/yt-automation-engine/videos/
data/yt-automation-engine/temp/
temp/
videos/
*.mp4
*.wav
*.mp3
*.webm
*.avi
*.mov
espeak-ng-data/

# Logs & Runtime State
*.log
pipeline.log
*.tmp
tasks_db.json
quota_tracker.json

# Scratch, Test Runs & Agent Files
scratch/
.agents/
.gemini/
.idea/
.vscode/
*.swp
*~
Thumbs.db
Desktop.ini
