# =============================================================================
# Convo Shorts Pipeline — Git Ignore Rules
# =============================================================================

# Python artifacts
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/

# Secrets & OAuth Credentials
*.env
.env.*
!.env.example
*token*.json
*token*.pickle
*credentials*.json
*secret*.json

# Runtime Output & Media Assets
data/yt-automation-engine/videos/
data/yt-automation-engine/temp/
temp/
videos/
*.mp4
*.wav
*.mp3
*.webm

# Logs & Runtime State
*.log
pipeline.log
tasks_db.json

# Scratch & Temporary
scratch/
.agents/
.vscode/
.idea/
